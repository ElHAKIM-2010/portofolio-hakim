---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectPreview from "../../components/ProjectPreview.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  next: CollectionEntry<"projects">;
}

const { project, next } = Astro.props;
const {
  title,
  category,
  summary,
  status,
  statusLabel,
  statusNote,
  role,
  year,
  technologies,
  links,
} = project.data;

const { Content, headings } = await render(project);
const toc = headings.filter((heading) => heading.depth === 2);
const hasLinks = Boolean(links.demo || links.source);

const siteUrl = Astro.site?.toString().replace(/\/$/, "");
const ogImage = project.data.ogImage ?? "/og/og-default.png";
const url = siteUrl ? `${siteUrl}/work/${project.id}/` : undefined;
const structuredData =
  siteUrl && url
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "CreativeWork",
            "@id": `${url}#project`,
            "name": title,
            "description": summary,
            "url": url,
            "image": `${siteUrl}${ogImage}`,
            "genre": category,
            "keywords": technologies.join(", "),
            "inLanguage": "id",
            "copyrightYear": Number(year),
            "creator": {
              "@type": "Person",
              "name": "El Hakim",
              "url": `${siteUrl}/`,
              "sameAs": ["https://github.com/ELHAKIM-2010"],
            },
          },
          {
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Beranda",
                "item": `${siteUrl}/`,
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "Proyek",
                "item": `${siteUrl}/#work`,
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": title,
                "item": url,
              },
            ],
          },
        ],
      }
    : undefined;
---

<BaseLayout
  title={`${title} | El Hakim`}
  description={summary}
  image={ogImage}
  imageAlt={`${title}, kartu studi kasus El Hakim.`}
  ogType="article"
  structuredData={structuredData}
>
  <Header />

  <main id="main">
    <div class="reading-progress" aria-hidden="true">
      <span class="reading-progress__bar"></span>
    </div>

    <article class="case">
      <header class="case__head shell">
        <nav class="case__crumb" aria-label="Breadcrumb">
          <a href="/#work">Proyek</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>

        <div class="case__intro">
          <div class="case__kicker">
            <span class="label">{category}</span>
            <span class:list={["status", `status--${status}`]}>
              <span class="status__dot" aria-hidden="true"></span>
              {statusLabel}
            </span>
          </div>

          <h1 class="case__title">{title}</h1>
          <p class="case__summary">{summary}</p>
        </div>

        <dl class="case__facts">
          <div>
            <dt class="label">Tahun</dt>
            <dd>{year}</dd>
          </div>
          <div>
            <dt class="label">Peran</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt class="label">Kategori</dt>
            <dd>{category}</dd>
          </div>
          <div>
            <dt class="label">Teknologi</dt>
            <dd>
              {technologies.length
                ? technologies.join(", ")
                : "Belum ditetapkan"}
            </dd>
          </div>
        </dl>
      </header>

      <div class="case__media shell">
        <ProjectPreview project={project} priority />
      </div>

      <div class="case__body shell">
        <aside class="case__aside" aria-label="Detail proyek">
          <div class="case__aside-inner">
            <p class="label">Status</p>
            <p class="case__note">{statusNote}</p>

            {
              hasLinks ? (
                <ul class="case__links">
                  {links.demo && (
                    <li>
                      <a
                        href={links.demo}
                        class="link-arrow"
                        target="_blank"
                        rel="noopener"
                      >
                        Buka demo <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  )}
                  {links.source && (
                    <li>
                      <a
                        href={links.source}
                        class="link-arrow"
                        target="_blank"
                        rel="noopener"
                      >
                        Kode sumber <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  )}
                </ul>
              ) : (
                <p class="case__unavailable">
                  Demo dan kode sumber belum tersedia untuk publik.
                </p>
              )
            }

            {
              toc.length > 0 && (
                <nav class="case__toc" aria-labelledby="case-toc-title">
                  <p class="label" id="case-toc-title">
                    Isi catatan
                  </p>
                  <ol>
                    {toc.map((heading, index) => (
                      <li>
                        <a href={`#${heading.slug}`} data-toc={heading.slug}>
                          <span class="label">
                            {String(index + 1).padStart(2, "0")}
                          </span>
                          <span>{heading.text}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </nav>
              )
            }

            <a href="/#work" class="link-arrow case__back">
              <span aria-hidden="true">←</span> Semua proyek
            </a>
          </div>
        </aside>

        <div class="case__content prose" data-reveal>
          <Content />
        </div>
      </div>

      <ProjectGallery project={project} />

      <nav class="case__next shell" aria-label="Proyek berikutnya">
        <span class="label">Proyek berikutnya</span>
        <a href={`/work/${next.id}/`} class="case__next-link">
          <span>{next.data.title}</span>
          <span aria-hidden="true">→</span>
        </a>
        <span class="label">{next.data.category}</span>
      </nav>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 70;
    width: 100%;
    height: 2px;
    pointer-events: none;
  }

  .reading-progress__bar {
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--c-accent);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  .case__head {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .case__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    padding-bottom: 1rem;
    border-bottom: var(--hairline) solid var(--c-line);
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case__crumb a {
    color: var(--c-ink-soft);
    text-decoration: none;
  }

  .case__crumb a:hover {
    color: var(--c-ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .case__intro {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }

  .case__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .case__title {
    font-size: clamp(3rem, 9vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }

  .case__summary {
    max-width: 40rem;
    color: var(--c-ink-soft);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .case__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem var(--gutter);
    margin: 0;
    padding-block: 1.25rem;
    border-top: var(--hairline) solid var(--c-line);
    border-bottom: var(--hairline) solid var(--c-line);
  }

  .case__facts div {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    min-width: 0;
  }

  .case__facts dd {
    margin: 0;
    color: var(--c-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .case__media {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .case__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 3rem var(--gutter);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: var(--hairline) solid var(--c-line);
  }

  .case__aside {
    grid-column: 1 / 4;
    min-width: 0;
  }

  .case__aside-inner {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    max-height: calc(100svh - var(--header-height) - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.25rem;
  }

  .case__note {
    padding-top: 0.9rem;
    border-top: var(--hairline) solid var(--c-line);
    width: 100%;
    color: var(--c-ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .case__links {
    display: grid;
    gap: 0.7rem;
    width: 100%;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .case__unavailable {
    color: var(--c-muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .case__toc {
    width: 100%;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: var(--hairline) solid var(--c-line);
  }

  .case__toc ol {
    display: grid;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .case__toc a {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 0.45rem;
    color: var(--c-ink-soft);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-editorial);
  }

  .case__toc a:hover {
    color: var(--c-ink);
  }

  .case__toc a[aria-current="location"] {
    color: var(--c-ink);
  }

  .case__toc a[aria-current="location"] .label {
    color: var(--c-accent);
  }

  .case__back {
    margin-top: 0.6rem;
  }

  .case__content {
    grid-column: 4 / -1;
    min-width: 0;
  }

  .case__next {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: var(--hairline) solid var(--c-line);
  }

  .case__next-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 4vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-editorial);
  }

  .case__next-link span:last-child {
    transition: transform var(--dur-base) var(--ease-editorial);
  }

  .case__next-link:hover span:last-child {
    transform: translateX(6px);
  }

  @media (max-width: 960px) {
    .case__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case__aside,
    .case__content {
      grid-column: 1 / -1;
    }

    .case__aside-inner {
      position: static;
      max-height: none;
      overflow: visible;
      padding-right: 0;
    }
  }

  @media (max-width: 560px) {
    .case__facts {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .case__next-link {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
  }
</style>

<script is:inline>
  (() => {
    const bar = document.querySelector(".reading-progress__bar");
    const article = document.querySelector(".case");
    const links = [...document.querySelectorAll("[data-toc]")];
    const headings = links
      .map((link) => document.getElementById(link.dataset.toc))
      .filter(Boolean);
    const header = document.querySelector(".site-header");

    function update() {
      if (bar && article) {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 0));
        bar.style.transform = `scaleX(${total > 0 ? scrolled / total : 0})`;
      }

      const offset = (header?.offsetHeight ?? 0) + 48;
      let active = -1;
      for (let index = 0; index < headings.length; index++) {
        if (headings[index].getBoundingClientRect().top <= offset) {
          active = index;
        }
      }

      for (let index = 0; index < links.length; index++) {
        if (index === active) {
          links[index].setAttribute("aria-current", "location");
        } else {
          links[index].removeAttribute("aria-current");
        }
      }
    }

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    window.addEventListener("load", update, { passive: true });

    if (article && "ResizeObserver" in window) {
      new ResizeObserver(update).observe(article);
    }
  })();
</script>
