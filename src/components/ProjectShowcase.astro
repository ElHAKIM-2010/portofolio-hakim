---
import type { CollectionEntry } from "astro:content";
import ProjectPreview from "./ProjectPreview.astro";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const {
  title,
  category,
  summary,
  status,
  statusLabel,
  year,
  technologies,
  links,
} = project.data;
const href = `/work/${project.id}/`;
const demoHost = links.demo ? new URL(links.demo).hostname : null;
const number = String(index).padStart(2, "0");
const totalLabel = String(total).padStart(2, "0");
const layout = index === 1 ? "wide" : "offset";
---

<article
  class:list={["project", `project--${layout}`]}
  aria-labelledby={`project-${project.id}`}
>
  <div class="project__meta" data-reveal>
    <div class="project__kicker">
      <span class="label">{number} / {totalLabel}</span>
      <span class="label">{category}</span>
    </div>

    <h3 class="project__title" id={`project-${project.id}`}>
      <a href={href}>{title}</a>
    </h3>

    <p class="project__summary">{summary}</p>

    <div class="project__foot">
      <div class="project__facts">
        <span class:list={["status", `status--${status}`]}>
          <span class="status__dot" aria-hidden="true"></span>
          {statusLabel}
        </span>
        <span class="label">{year}</span>
      </div>

      <p class="tech-list project__tech">
        {technologies.length
          ? technologies.join(" · ")
          : "Teknologi belum ditetapkan"}
      </p>

      <div class="project__actions">
        <a href={href} class="link-arrow project__link">
          Baca studi kasus <span aria-hidden="true">→</span>
        </a>

        {
          links.demo && demoHost && (
            <a
              href={links.demo}
              class="project__live"
              target="_blank"
              rel="noopener"
              aria-label={`Buka demo ${title} di tab baru`}
            >
              {demoHost} <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div
    class="project__media"
    data-reveal
    style="--reveal-delay: 90ms"
  >
    <ProjectPreview project={project} />
  </div>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.75rem var(--gutter);
    align-items: stretch;
  }

  .project + .project {
    margin-top: clamp(3.5rem, 7vw, 6.5rem);
    padding-top: clamp(3.5rem, 7vw, 6.5rem);
    border-top: var(--hairline) solid var(--c-line);
  }

  .project__meta {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-width: 0;
  }

  .project__kicker {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    padding-bottom: 0.85rem;
    border-bottom: var(--hairline) solid var(--c-line);
  }

  .project__title {
    font-size: clamp(2.25rem, 1.3rem + 2.8vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .project__title a {
    color: var(--c-ink);
    text-decoration: none;
    background-image: linear-gradient(var(--c-accent), var(--c-accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 0.09em;
    transition: background-size var(--dur-base) var(--ease-editorial);
  }

  .project:hover .project__title a,
  .project__title a:focus-visible {
    background-size: 100% 0.09em;
  }

  .project__summary {
    max-width: 31rem;
    color: var(--c-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .project__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: var(--hairline) solid var(--c-line);
  }

  .project__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    width: 100%;
  }

  .project__tech {
    margin: 0;
  }

  .project__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.5rem;
    width: 100%;
    margin-top: 0.35rem;
  }

  .project__link {
    margin-top: 0;
  }

  .project__live {
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-bottom: var(--hairline) solid transparent;
    overflow-wrap: anywhere;
    transition: border-color var(--dur-fast) var(--ease-editorial);
  }

  .project__live:hover {
    border-bottom-color: currentColor;
  }

  .project__media {
    min-width: 0;
  }

  .project:hover :global(.preview__frame) {
    transform: translateY(-3px);
    box-shadow: 0 28px 50px -38px rgba(10, 10, 8, 0.55);
  }

  /* Layout 01 — text left, wide preview right */

  .project--wide .project__meta {
    grid-column: 1 / 5;
  }

  .project--wide .project__media {
    grid-column: 5 / -1;
  }

  /* Layout 02 — preview left, text right */

  .project--offset .project__media {
    grid-column: 1 / 7;
    grid-row: 1;
  }

  .project--offset .project__meta {
    grid-column: 8 / -1;
    grid-row: 1;
    padding-top: clamp(0rem, 2vw, 1.5rem);
  }

  @media (max-width: 960px) {
    .project--wide .project__meta,
    .project--wide .project__media,
    .project--offset .project__meta,
    .project--offset .project__media,
    .project__meta,
    .project__media {
      grid-column: 1 / -1;
    }

    .project--offset .project__meta {
      grid-row: auto;
      padding-top: 0;
    }

    .project--offset .project__media {
      grid-row: auto;
    }

    .project__media {
      margin-top: 0.25rem;
    }
  }
</style>
