---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { preview, title } = project.data;
---

<figure
  class:list={[
    "preview",
    preview.image ? "preview--photo" : `preview--${preview.kind}`,
  ]}
  role={preview.image ? undefined : "img"}
  aria-label={preview.image ? undefined : `${title} — ${preview.caption}`}
>
  <div class="preview__frame">
    {
      preview.image && (
        <>
          <div class="preview__chrome preview__chrome--shot" aria-hidden="true">
            <span>{title.toUpperCase()}</span>
            <span>TANGKAPAN LAYAR · DATA CONTOH</span>
          </div>
          <img
            class="preview__shot"
            src={preview.image.src}
            srcset={`${preview.image.srcSmall} 800w, ${preview.image.src} 1440w`}
            sizes="(max-width: 960px) calc(100vw - 2.5rem), 60vw"
            width={preview.image.width}
            height={preview.image.height}
            alt={preview.image.alt}
            loading="lazy"
            decoding="async"
          />
        </>
      )
    }

    {
      !preview.image && preview.kind === "commerce" && (
        <>
          <div class="preview__chrome" aria-hidden="true">
            <span>USK / TECH PREMIUM</span>
            <span>MOCKUP · DATA CONTOH</span>
          </div>
          <div class="commerce" aria-hidden="true">
            <div class="commerce__head">
              <p class="commerce__label">Elektronik / Katalog 2026</p>
              <p class="commerce__title">
                Pilih alat,<br />
                <em>bukan kebisingan.</em>
              </p>
              <p class="commerce__note">Katalog ringkas untuk kebutuhan harian.</p>
            </div>
            <div class="commerce__grid">
              <div class="product">
                <div class="product__art">
                  <svg viewBox="0 0 120 100" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M28 62V48a32 32 0 0 1 64 0v14" />
                    <rect x="19" y="56" width="17" height="28" rx="8" />
                    <rect x="84" y="56" width="17" height="28" rx="8" />
                    <path d="M36 84h48" opacity="0.35" />
                  </svg>
                </div>
                <p class="product__name">Studio Headphones</p>
                <p class="product__meta">Audio · Rp 1.250.000</p>
              </div>
              <div class="product">
                <div class="product__art">
                  <svg viewBox="0 0 120 100" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="14" y="34" width="92" height="36" rx="2" />
                    <path
                      d="M22 44h7M34 44h7M46 44h7M58 44h7M70 44h7M82 44h7M94 44h5M22 54h7M34 54h7M46 54h7M58 54h7M70 54h7M82 54h7M94 54h5M22 64h77"
                      opacity="0.6"
                    />
                  </svg>
                </div>
                <p class="product__name">Mechanical Keyboard</p>
                <p class="product__meta">Workspace · Rp 850.000</p>
              </div>
              <div class="product">
                <div class="product__art">
                  <svg viewBox="0 0 120 100" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="18" y="20" width="84" height="52" rx="2" />
                    <path d="M52 86h16M60 72v14" />
                    <path d="M28 32h30M28 42h18" opacity="0.5" />
                    <circle cx="88" cy="31" r="2.5" fill="currentColor" stroke="none" />
                  </svg>
                </div>
                <p class="product__name">Field Monitor</p>
                <p class="product__meta">Visual · Rp 2.400.000</p>
              </div>
            </div>
            <div class="commerce__foot">
              <span>Katalog / 03 item</span>
              <span>Halaman 01</span>
            </div>
          </div>
        </>
      )
    }

    {
      !preview.image && preview.kind === "records" && (
        <>
          <div class="preview__chrome preview__chrome--dark" aria-hidden="true">
            <span>DATA SISWA</span>
            <span>MOCKUP · DATA CONTOH</span>
          </div>
          <div class="records" aria-hidden="true">
            <div class="records__head">
              <div>
                <p class="records__title">Data Siswa</p>
                <p class="records__meta">24 siswa · 3 kelas</p>
              </div>
              <span class="records__add">+ Tambah</span>
            </div>
            <div class="records__search">
              <span class="records__search-text">Cari nama atau kelas…</span>
              <span class="records__search-mark" aria-hidden="true"></span>
            </div>
            <div class="records__table">
              <div class="records__row records__row--head">
                <span>Nama</span>
                <span>Kelas</span>
                <span>Status</span>
              </div>
              <div class="records__row">
                <span>Siswa 01</span>
                <span>X RPL 1</span>
                <span class="records__status">Aktif</span>
              </div>
              <div class="records__row">
                <span>Siswa 02</span>
                <span>X RPL 1</span>
                <span class="records__status">Aktif</span>
              </div>
              <div class="records__row records__row--active">
                <span>Siswa 03</span>
                <span>XI RPL 2</span>
                <span class="records__status">Ditinjau</span>
              </div>
              <div class="records__row">
                <span>Siswa 04</span>
                <span>X RPL 2</span>
                <span class="records__status">Aktif</span>
              </div>
            </div>
            <div class="records__foot">
              <span>4 dari 24 baris</span>
              <span>01 / 06</span>
            </div>
          </div>
        </>
      )
    }

  </div>

  <figcaption class="preview__caption">
    <span class="label">Preview</span>
    <span>{preview.caption}</span>
  </figcaption>
</figure>

<style>
  .preview {
    --mock-ink: #17181a;
    --mock-paper: #f4f1e8;
    --mock-raised: #eae5d8;
    --mock-line: #d7d1c3;
    --mock-muted: #6d6a61;
    --mock-accent: #2f5d50;
    --mock-accent-soft: #8fbfa9;
    --mock-accent-ink: #f4f1e8;
    container-type: inline-size;
    margin: 0;
  }

  .preview__frame {
    position: relative;
    overflow: hidden;
    border: var(--hairline) solid var(--c-line);
    border-top: 2px solid var(--mock-accent);
    background-color: var(--mock-paper);
    color: var(--mock-ink);
    transition:
      transform var(--dur-base) var(--ease-editorial),
      box-shadow var(--dur-base) var(--ease-editorial);
  }

  .preview__chrome {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    border-bottom: var(--hairline) solid rgba(245, 242, 234, 0.18);
    color: rgba(245, 242, 234, 0.65);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .preview__chrome--dark,
  .preview__chrome--shot {
    border-bottom-color: var(--mock-line);
    color: var(--mock-muted);
  }

  .preview--photo .preview__frame {
    background-color: var(--mock-paper);
    border-top-color: var(--mock-accent);
  }

  .preview__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  .preview__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
    margin-top: 0.7rem;
    color: var(--c-muted);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  /* Commerce */

  .preview--commerce .preview__frame {
    background-color: var(--mock-ink);
    color: var(--mock-paper);
    border-top-color: var(--mock-accent-soft);
  }

  .commerce {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 3cqw, 1.75rem);
    padding: clamp(1rem, 4cqw, 2rem);
  }

  .commerce__label {
    color: rgba(245, 242, 234, 0.5);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .commerce__title {
    margin-top: 0.65rem;
    color: var(--mock-paper);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 6.5cqw, 3.2rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    max-width: 12ch;
  }

  .commerce__title em {
    font-style: italic;
  }

  .commerce__note {
    margin-top: 0.7rem;
    color: rgba(245, 242, 234, 0.55);
    font-size: 0.6875rem;
  }

  .commerce__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--hairline) solid rgba(245, 242, 234, 0.16);
  }

  .product {
    padding: 0.9rem 0.8rem 0;
    border-right: var(--hairline) solid rgba(245, 242, 234, 0.16);
  }

  .product:last-child {
    border-right: 0;
  }

  .product__art {
    height: clamp(3rem, 9cqw, 5rem);
    color: var(--mock-paper);
  }

  .product__art svg {
    width: 100%;
    height: 100%;
  }

  .product__name {
    margin-top: 0.65rem;
    color: var(--mock-paper);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .product__meta {
    margin-top: 0.2rem;
    color: rgba(245, 242, 234, 0.5);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    line-height: 1.4;
  }

  .commerce__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgba(245, 242, 234, 0.45);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Records */

  .records {
    display: grid;
    gap: 0.9rem;
    padding: clamp(1rem, 4cqw, 2rem);
  }

  .records__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .records__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4.8cqw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .records__meta {
    margin-top: 0.35rem;
    color: var(--mock-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
  }

  .records__add {
    flex: none;
    padding: 0.45rem 0.6rem;
    background-color: var(--mock-ink);
    color: var(--mock-paper);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .records__search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.65rem;
    border: var(--hairline) solid var(--mock-line);
    color: var(--mock-muted);
    font-size: 0.625rem;
  }

  .records__search-mark {
    width: 0.45rem;
    height: 0.45rem;
    flex: none;
    border: 1px solid var(--mock-muted);
    border-radius: 50%;
  }

  .records__table {
    border-top: var(--hairline) solid var(--mock-ink);
  }

  .records__row {
    display: grid;
    grid-template-columns: 1.5fr 0.85fr 0.85fr;
    gap: 0.5rem;
    align-items: center;
    padding: 0.55rem 0.4rem;
    border-bottom: var(--hairline) solid var(--mock-line);
    font-size: 0.625rem;
  }

  .records__row--head {
    color: var(--mock-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .records__row--active {
    background-color: var(--mock-accent);
    color: var(--mock-accent-ink);
  }

  .records__status {
    justify-self: start;
    color: var(--mock-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .records__row--active .records__status {
    color: var(--mock-accent-ink);
  }

  .records__foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--mock-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
  }

  @container (max-width: 560px) {
    .product:nth-child(3) {
      display: none;
    }

    .commerce__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .commerce__note {
      display: none;
    }
  }

  @container (max-width: 460px) {
    .records__row {
      grid-template-columns: 1.4fr 0.9fr;
    }

    .records__row > :nth-child(3) {
      display: none;
    }
  }
</style>
