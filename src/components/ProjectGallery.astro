---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { gallery, title } = project.data;
---

{
  gallery.length > 0 && (
    <section class="gallery shell" aria-labelledby="gallery-title">
      <div class="gallery__head" data-reveal>
        <span class="label">Tangkapan layar</span>
        <h2 id="gallery-title" class="gallery__title">
          Halaman yang<br /><em>sudah berjalan.</em>
        </h2>
        <p class="gallery__note">
          Diambil langsung dari {title} dengan data contoh. Tampilan memakai
          tema terang; tema gelap tersedia lewat tombol di navigasi.
        </p>
      </div>

      <div class="gallery__grid">
        {gallery.map((item, index) => (
          <figure
            class="gallery__item"
            data-reveal
            style={`--reveal-delay: ${index * 60}ms`}
          >
            <div class="gallery__frame">
              <img
                src={item.src}
                srcset={`${item.srcSmall} 800w, ${item.src} 1440w`}
                sizes="(max-width: 720px) calc(100vw - 2.5rem), 46vw"
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="gallery__caption">
              <span class="label">{String(index + 1).padStart(2, "0")}</span>
              <span>{item.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .gallery {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-top: var(--hairline) solid var(--c-line);
  }

  .gallery__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.75rem var(--gutter);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .gallery__head .label {
    grid-column: 1 / -1;
  }

  .gallery__title {
    grid-column: 1 / 7;
    font-size: clamp(2rem, 1.2rem + 2.8vw, 3.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .gallery__title em {
    font-style: italic;
  }

  .gallery__note {
    grid-column: 8 / -1;
    justify-self: end;
    max-width: 30rem;
    color: var(--c-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem) var(--gutter);
  }

  .gallery__item {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    margin: 0;
  }

  .gallery__frame {
    padding: clamp(0.35rem, 0.8vw, 0.6rem);
    border: var(--hairline) solid var(--c-line);
    background-color: var(--c-paper-raised);
    transition:
      transform var(--dur-base) var(--ease-editorial),
      box-shadow var(--dur-base) var(--ease-editorial);
  }

  .gallery__item:hover .gallery__frame {
    transform: translateY(-3px);
    box-shadow: 0 28px 50px -38px rgba(10, 10, 8, 0.55);
  }

  .gallery__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gallery__caption {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding-top: 0.7rem;
    border-top: var(--hairline) solid var(--c-line);
    color: var(--c-ink-soft);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .gallery__caption .label {
    flex: none;
    color: var(--c-muted);
  }

  @media (max-width: 960px) {
    .gallery__title,
    .gallery__note {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (max-width: 720px) {
    .gallery__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__frame {
      transition: none;
    }
  }
</style>
