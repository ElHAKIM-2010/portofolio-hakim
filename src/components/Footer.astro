---
const links = [
  { href: "/#work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "/#skills", label: "Skills" },
  { href: "/#contact", label: "Contact" },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__top">
      <p class="site-footer__word">
        EL HAKIM<span class="site-footer__square" aria-hidden="true"></span>
      </p>

      <nav class="site-footer__nav" aria-label="Navigasi footer">
        <ul>
          {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <span class="label">© {year} El Hakim</span>
      <span class="label">Edisi 01 — Dibangun dengan Astro</span>
      <a href="#main" class="label site-footer__top-link">
        Kembali ke atas <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline) solid var(--c-line);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 3rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .site-footer__word {
    display: flex;
    align-items: flex-start;
    gap: 0.15em;
    font-family: var(--font-display);
    font-size: clamp(3rem, 14vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .site-footer__square {
    width: 0.09em;
    height: 0.09em;
    margin-top: 0.14em;
    flex: none;
    background-color: var(--c-accent);
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0 0 0.4rem;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav a {
    color: var(--c-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-editorial);
  }

  .site-footer__nav a:hover {
    color: var(--c-ink);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    padding-top: 1.1rem;
    border-top: var(--hairline) solid var(--c-line);
  }

  .site-footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-ink);
    text-decoration: none;
  }

  .site-footer__top-link span {
    transition: transform var(--dur-base) var(--ease-editorial);
  }

  .site-footer__top-link:hover span {
    transform: translateY(-3px);
  }
</style>
